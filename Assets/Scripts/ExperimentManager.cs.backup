using System;
using System.Collections.Generic;
using System.Linq;
using System.IO;
using UnityEngine;
using UnityEngine.XR.Hands;
using TMPro;
using UnityEngine.UI;
using System.Diagnostics;
using System.Text.RegularExpressions;
using Unity.XR.CoreUtils;
using UnityEditor;

public class ExperimentManager : MonoBehaviour
{
    // Gesture score threshold for Jackknife recognizer
    private const double GESTURE_SCORE_THRESHOLD = 0.25f;

    // Minimum allowed number of points after applying DP line simplification
    private const uint GESTURE_SIMPLIFICATION_SCORE_THRESHOLD = 3;

    // Minimum allowed length of the created gesture
    private const float GESTURE_LENGTH_THRESHOLD = 0.45f;

    // How long a gesture feedback is shown after tutorial is finished
    private const long TUTORIAL_FEEDBACK_INTERVAL_MILLISECONDS = 2000;

    // How far away from the main camera the information board is
    private const float BOARD_DISTANCE = 4;

    // How far away from the main camera the interaction cube is
    private const float INTERACTION_CUBE_DISTANCE = 0.4f;

    // How far away from the main camera the interaction region is
    private const float INTERACTION_REGION_DISTANCE = 0.2f;

    // Where information board is located
    private readonly Vector3 BOARD_POSITION_OFFSET = new Vector3(0, 1f, 0);

    // Where interaction cube is located
    private readonly Vector3 INTERACTION_CUBE_POSITION_OFFSET = new Vector3(0, -0.195f, 0);

    // Where interaction region is located
    private readonly Vector3 INTERACTION_REGION_POSITION_OFFSET = new Vector3(0, -0.195f, 0);

    // Rotation of the left interaction cube
    private readonly Quaternion INTERACTION_CUBE_LEFT_ROTATION = Quaternion.Euler(0, -40, 0);

    // Rotation of the right interaction cube
    private readonly Quaternion INTERACTION_CUBE_RIGHT_ROTATION = Quaternion.Euler(0, 40, 0);

    enum ExperimentStageEnum
    {
        UninitializedStage,
        SetupStage,
        TutorialStage,
        CreateStage,
        MatchStage,
        PracticeStage,
        DistractStage,
        RecallStage,
        FinishStage,
        RecallSetupStage
    }

    enum TutorialStageEnum
    {
        AxisX,
        AxisY,
        AxisZ,
        Diagonal
    }

    private ExperimentStageEnum currentExperimentStage;             // Current experiment stage
    private string experimentPath;                                  // Path to the working directory
    private string logPath;                                         // Path to the log file
    private string sampleDir;                                       // Name of the sample gesture directory
    private string queryDir;                                        // Name of the query gesture directory

    private TutorialStageEnum currentTutorialStage;                 // Current tutorial stage
    private const string axisXDir = "AxisX";                        // Name of the X axis tutorial directory
    private const string axisYDir = "AxisY";                        // Name of the Y axis tutorial directory
    private const string axisZDir = "AxisZ";                        // Name of the Z axis tutorial directory
    private const string diagonalDir = "Diagonal";                  // Name of the diagonal tutorial directory

    private XRHandSubsystem m_HandSubsystem;                        // XRHand subsystem for hands rendering
    private GestureHandler gestureHandler;                          // Gesture handler
    private InteractionHandler interactionHandler;                  // Interaction handler

    private delegate void ProcedureCallback();                      // Callback for the experiment's procedures

    ProcedureCallback gesturePassedCallback;                        // Gesture is valid or mathed the sample gesture
    ProcedureCallback gestureFailedCallback;                        // Gesutre is invalid or didn't match the sample gesture

    private GameObject localCoordinateFrame;                        // Local coordinate frame from the main camera viewpoint

    private uint currentPracticeAttempt;                            // Number of the current practice attempt
    private uint currentRecallAttempt;                              // Number of the current recall attempt
    private bool distractFinished;                                  // Finished distract period
    private bool recallFinished;                                    // Succesffully recalled the gesture

    private readonly Stopwatch stopwatchTotal = new Stopwatch();    // Timer for the total experiment time
    private readonly Stopwatch stopwatchStage = new Stopwatch();    // Timer for the stage time
    private readonly Stopwatch stopwatchFeedback = new Stopwatch(); // Timer for the feedback interval
    private readonly Stopwatch stopwatchDistract = new Stopwatch(); // Timer for the distract period
    private bool stageStarted;                                      // Experiment stage started with the first gesture drawing
    private bool feedbackStarted;                                   // Gesture feedback screen is displayed

    [Tooltip("Experiment subject's code")]
    [SerializeField] private string subjectCode;

    [Tooltip("Recall previous gesture")]
    [SerializeField] private bool continueExperiment;

    [Tooltip("Number of practice rounds")]
    [SerializeField] private uint practiceRounds;

    [Tooltip("Number of recall attempts")]
    [SerializeField] private uint recallAttempts;

    [Tooltip("Number of seconds for distract stage")]
    [SerializeField] private long distractTimeSeconds;

    [SerializeField] private LineRenderer gestureTrail;                     // Line renderer for the gesture trail
    [SerializeField] private Transform mainCameraTransform;                 // Transform of the main camera

    [SerializeField] private GameObject interactionCubeLeft;                // Left interaction cube object
    [SerializeField] private GameObject interactionCubeRight;               // Right interaction cube object
    [SerializeField] private GameObject interactionRegion;                  // Interaction region object
    [SerializeField] private GameObject informationBoard;                   // Information board object

    [SerializeField] private GameObject feedbackSphere;                     // Sphere for feedback

    [SerializeField] private LineRenderer tutorialLine;                     // Tutorial line connecting start point to the end point
    [SerializeField] private GameObject startPoint;                         // Start point object
    [SerializeField] private GameObject endPoint;                           // End point object

    [SerializeField] private TextMeshProUGUI informationTextCenter;         // Information board's center text
    [SerializeField] private TextMeshProUGUI informationTextCenterTop;      // Information board's center top text
    [SerializeField] private TextMeshProUGUI informationTextCenterBottom;   // Information board's center bottom text
    [SerializeField] private TextMeshProUGUI informationTextLeft;           // Information board's left text
    [SerializeField] private TextMeshProUGUI informationTextRight;          // Information board's right text

    [SerializeField] private Image informationPicture;                      // Information board's picture object
    [SerializeField] private Sprite rightHandPinchSprite;                   // Sprite of the right hand pinch
    [SerializeField] private Sprite rightHandOpenSprite;                    // Sprite of the right open-hand gesture

    /**
     *  Start is called before the first frame update.
     */
    void Start()
    {
        InitializeExperiment();

        experimentPath = Path.Combine(Directory.GetParent(Application.dataPath).ToString(), "Experiment", "Sub_" + subjectCode);
        
        if (continueExperiment)
        {
            LoadPreviousExperiment();
        }
        else
        {
            SetupNewExperiment();
        }
    }

    private void InitializeExperiment()
    {
        localCoordinateFrame = new GameObject("Local Coordinate Frame");
        interactionHandler = new InteractionHandler(interactionCubeLeft, interactionCubeRight);
    }

    private void LoadPreviousExperiment()
    {
        string latestLogTimestamp = FindLatestTimestamp(Directory.GetFiles(experimentPath), @"(\d+)_log.txt");

        logPath = Path.Combine(experimentPath, latestLogTimestamp + "_log.txt");
        experimentPath = Path.Combine(experimentPath, "gestures", latestLogTimestamp);

        sampleDir = FindLatestTimestamp(Directory.GetDirectories(experimentPath), @"(\d+)_create") + "_create";

        gestureHandler = new GestureHandler(experimentPath, interactionRegion.transform, new TrailHandler(gestureTrail), feedbackSphere);
        RecallSetupStage();
    }

    private void SetupNewExperiment()
    {
        string currentTime = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds().ToString();

        logPath = Path.Combine(experimentPath, currentTime + "_log.txt");
        experimentPath = Path.Combine(experimentPath, "gestures", currentTime);

        if (!Directory.Exists(experimentPath))
        {
            CreateDirectories();
        }

        gestureHandler = new GestureHandler(experimentPath, interactionRegion.transform, new TrailHandler(gestureTrail), feedbackSphere);
        currentTutorialStage = TutorialStageEnum.AxisX;
        stopwatchTotal.Start();
        SetupStage();
    }

    private string FindLatestTimestamp(string[] names, string pattern)
    {
        List<string> timestamps = new List<string>();
        foreach (string name in names)
        {
            Match timestamp = Regex.Match(name, pattern);
            if (timestamp.Success)
            {
                timestamps.Add(timestamp.Groups[1].Value);
            }
        }
        return timestamps.Max();
    }

    private void CreateDirectories()
    {
        Directory.CreateDirectory(experimentPath);

        string tutorialPath = Path.Combine(Directory.GetParent(Application.dataPath).ToString(), "Tutorial");

        foreach (string tutorialID in Enum.GetNames(typeof(TutorialStageEnum)))
        {
            Directory.CreateDirectory(Path.Combine(experimentPath, tutorialID));
            UnityEngine.Debug.Log(tutorialID);
            File.Copy(Path.Combine(tutorialPath, tutorialID, "ex.txt"), Path.Combine(experimentPath, tutorialID, "ex.txt"));
        }
    }

    /**
     *  Update is called once per frame.
     */
    void Update()
    {
        // Distract stage
        if (currentExperimentStage == ExperimentStageEnum.DistractStage)
        {
            DistractStage();

            return;
        }

        // If feedback screen is displayed
        if (feedbackStarted)
        {
            CreateStage();

            return;
        }

        // If the hand subsystem is null, then restart the stage from the initialization
        if (m_HandSubsystem == null) 
        {
            switch (currentExperimentStage)
            {
                case ExperimentStageEnum.SetupStage:
                    SetupStage();
                    break;
                case ExperimentStageEnum.RecallSetupStage:
                    RecallSetupStage();
                    break;
            }
        }
    }

    /**
     *  Setup stage of the experiment.
     */
    private void SetupStage()
    {
        currentExperimentStage = ExperimentStageEnum.SetupStage;

        InformationDisableAll();
        interactionCubeLeft.GetComponent<MeshRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Put your <b>right</b> hand into the cube and wait";
        informationPicture.sprite = rightHandOpenSprite;

        // Update the location of the information board and interaction cube at each frame
        interactionHandler.UserPromptCallback = () =>
        {
            // Move information board to the current main camera viewpoint
            PositionObject(informationBoard, mainCameraTransform, BOARD_POSITION_OFFSET, Vector3.zero, Quaternion.identity, BOARD_DISTANCE);

            // Move left interaction cube to the current main camera viewpoint
            PositionObject(interactionCubeLeft, mainCameraTransform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, Quaternion.identity, INTERACTION_CUBE_DISTANCE);
        };
        interactionHandler.UserActionCallback1 = () =>
        {
            // Record current transform of the main camera
            RecordCurrentTransform(localCoordinateFrame);

            TutorialStage();
        };
        interactionHandler.UserActionCallback2 = null;

        InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);
    }

    /**
     *  Tutorial stage of the experiment.
     */
    private void TutorialStage()
    {
        currentExperimentStage = ExperimentStageEnum.TutorialStage;

        InformationDisableAll();
        tutorialLine.enabled = true;
        startPoint.GetComponent<MeshRenderer>().enabled = true;
        endPoint.GetComponent<MeshRenderer>().enabled = true;
        interactionRegion.GetComponent<LineRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Pinch with your <b>right</b> hand to start a gesture\nRelease the pinch to finish a gesture\nConnect two dots starting from the <color=red>RED</color> dot";
        informationPicture.sprite = rightHandPinchSprite;

        // Move interaction region to the original main camera viewpoint
        PositionObject(interactionRegion, localCoordinateFrame.transform, INTERACTION_REGION_POSITION_OFFSET, INTERACTION_REGION_POSITION_OFFSET, Quaternion.identity, INTERACTION_REGION_DISTANCE);

        gestureHandler.RecordStartedCallback = () =>
        {
            if (stageStarted == false)
            {
                stopwatchStage.Restart();

                stageStarted = true;
            }

            Log("Started drawing a gesture");
        };
        gestureHandler.RecordFinishedCallback = () =>
        {
            Log("Finished drawing a gesture");

            SaveQueryRecord();
        };
        // If the drawn gesture doesn't match the tutorial gesture, then prompt the user to restart 
        gestureFailedCallback = () =>
        {
            PromptToContinue(TutorialStage);

            informationTextCenter.text = "<color=red>The gesture doesn't match the example!</color>\n\n" + informationTextCenter.text;
        };

        switch (currentTutorialStage)
        {
            case TutorialStageEnum.AxisX:  
                sampleDir = axisXDir;

                queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_tutorial_axis_x";
                Directory.CreateDirectory(Path.Combine(experimentPath, queryDir));

                // Position example gesture
                PositionTutorialLine(new Vector3(-0.4f, 0, 0), new Vector3(0.4f, 0, 0));

                // If the drawn gesture matches the tutorial gesture, then proceed to the next stage of the tutorial
                gesturePassedCallback = () =>
                {
                    currentTutorialStage = TutorialStageEnum.AxisY;

                    PromptToContinue(TutorialStage);

                    informationTextCenter.text = "<color=green>The gesture matches the example!</color>\n\n" + informationTextCenter.text;
                };

                break;

            case TutorialStageEnum.AxisY:

                sampleDir = axisYDir;

                queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_tutorial_axis_y";
                Directory.CreateDirectory(Path.Combine(experimentPath, queryDir));

                // Position example gesture
                PositionTutorialLine(new Vector3(0, 0.4f, 0), new Vector3(0, -0.4f, 0));

                // If the drawn gesture matches the tutorial gesture, then proceed to the next stage of the tutorial
                gesturePassedCallback = () =>
                {
                    currentTutorialStage = TutorialStageEnum.AxisZ;

                    PromptToContinue(TutorialStage);

                    informationTextCenter.text = "<color=green>The gesture matches the example!</color>\n\n" + informationTextCenter.text;
                };

                break;

            case TutorialStageEnum.AxisZ:

                sampleDir = axisZDir;

                queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_tutorial_axis_z";
                Directory.CreateDirectory(Path.Combine(experimentPath, queryDir));

                // Position example gesture
                PositionTutorialLine(new Vector3(0, 0, -0.4f), new Vector3(0, 0, 0.4f));

                // If the drawn gesture matches the tutorial gesture, then proceed to the next stage of the tutorial
                gesturePassedCallback = () =>
                {
                    currentTutorialStage = TutorialStageEnum.Diagonal;

                    PromptToContinue(TutorialStage);

                    informationTextCenter.text = "<color=green>The gesture matches the example!</color>\n\n" + informationTextCenter.text;
                };

                break;

            case TutorialStageEnum.Diagonal:

                sampleDir = diagonalDir;

                queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_tutorial_diagonal";
                Directory.CreateDirectory(Path.Combine(experimentPath, queryDir));

                // Position example gesture
                PositionTutorialLine(new Vector3(-0.4f, -0.4f, -0.4f), new Vector3(0.4f, 0.4f, 0.4f));

                // If the drawn gesture matches the tutorial gesture, then proceed to the next stage of the experiment
                gesturePassedCallback = () =>
                {
                    stopwatchStage.Stop();

                    stageStarted = false;

                    Log("Tutorial Time: " + stopwatchStage.ElapsedMilliseconds + "ms");

                    PromptToContinue(() =>
                    {
                        InformationDisableAll();
                        informationTextCenter.enabled = true;
                        informationTextCenter.color = Color.white;

                        informationTextCenter.text = "Now, you will create your own gesture";

                        feedbackStarted = true;

                        stopwatchFeedback.Restart();

                        CreateStage();
                    });

                    informationTextCenter.text = "<color=green>The gesture matches the example!</color>\n\n" + informationTextCenter.text;
                };

                break;
        }

        InitializeHandSubsystem(ref m_HandSubsystem, gestureHandler.OnUpdatedHandsRecord);
    }

    /**
     *  Create stage of the experiment.
     */
    private void CreateStage()
    {
        currentExperimentStage = ExperimentStageEnum.CreateStage;
        
        if (feedbackStarted && stopwatchFeedback.ElapsedMilliseconds < TUTORIAL_FEEDBACK_INTERVAL_MILLISECONDS)
        {
            return;
        }

        feedbackStarted = false;

        gestureHandler.Clear();

        InformationDisableAll();
        interactionRegion.GetComponent<LineRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Create a gesture\nDraw your gesture inside the <color=#00FFFFFF>highlighted</color> area";
        informationPicture.sprite = rightHandPinchSprite;

        sampleDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_create";
        Directory.CreateDirectory(Path.Combine(experimentPath, sampleDir));

        // Move interaction region to the original main camera viewpoint
        PositionObject(interactionRegion, localCoordinateFrame.transform, INTERACTION_REGION_POSITION_OFFSET, INTERACTION_REGION_POSITION_OFFSET, Quaternion.identity, INTERACTION_REGION_DISTANCE);

        gestureHandler.RecordStartedCallback = () =>
        {
            if (stageStarted == false)
            {
                stopwatchStage.Restart();

                stageStarted = true;
            }

            Log("Started drawing a gesture");
        };
        gestureHandler.RecordFinishedCallback = () =>
        {
            Log("Finished drawing a gesture");

            SaveSampleRecord();
        };
        // If the created gesture is valid, then prompt the user to continue
        gesturePassedCallback = () =>
        {
            InformationDisableAll();
            interactionCubeLeft.GetComponent<MeshRenderer>().enabled = true;
            interactionCubeRight.GetComponent<MeshRenderer>().enabled = true;
            informationTextCenter.enabled = informationTextLeft.enabled = informationTextRight.enabled = informationPicture.enabled = true;
            informationTextCenter.text = "Confirm the gesture";
            informationTextLeft.text = "Put your <b>right</b> hand into the <b>LEFT</b> cube\nand wait to <color=red>create a new gesture</color>";
            informationTextRight.text = "Put your <b>right</b> hand into the <b>RIGHT</b> cube\nand wait to <color=green>confirm the gesture</color>";
            informationPicture.sprite = rightHandOpenSprite;

            // Move left interaction cube to the original main camera viewpoint
            PositionObject(interactionCubeLeft, localCoordinateFrame.transform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_LEFT_ROTATION, INTERACTION_CUBE_DISTANCE);

            // Move right interaction cube to the original main camera viewpoint
            PositionObject(interactionCubeRight, localCoordinateFrame.transform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_RIGHT_ROTATION, INTERACTION_CUBE_DISTANCE);

            interactionHandler.UserPromptCallback = null;
            interactionHandler.UserActionCallback1 = () =>
            {
                Log("Gesture is cancelled");

                CreateStage();
            };
            interactionHandler.UserActionCallback2 = MatchStage;

            InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);
        };
        // If the created gesture is invalid, then prompt the user to restart
        gestureFailedCallback = () =>
        {
            PromptToContinue(CreateStage);

            informationTextCenter.text = "The gesture is too simple\nPlease, try again\n\n" + informationTextCenter.text;
        };

        InitializeHandSubsystem(ref m_HandSubsystem, gestureHandler.OnUpdatedHandsRecord);
    }

    /**
     *  Match stage of the experiment.
     */
    private void MatchStage()
    {
        currentExperimentStage = ExperimentStageEnum.MatchStage;

        gestureHandler.Clear();

        InformationDisableAll();
        interactionRegion.GetComponent<LineRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Match the gesture\nDraw your gesture inside the <color=#00FFFFFF>highlighted</color> area";
        informationPicture.sprite = rightHandPinchSprite;

        queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_match";
        Directory.CreateDirectory(Path.Combine(experimentPath, queryDir));

        // Move interaction region to the original main camera viewpoint
        PositionObject(interactionRegion, localCoordinateFrame.transform, INTERACTION_REGION_POSITION_OFFSET, INTERACTION_REGION_POSITION_OFFSET, Quaternion.identity, INTERACTION_REGION_DISTANCE);

        gestureHandler.RecordStartedCallback = () =>
        {
            if (stageStarted == false)
            {
                stopwatchStage.Restart();

                stageStarted = true;
            }

            Log("Started drawing a gesture");
        };
        gestureHandler.RecordFinishedCallback = () =>
        {
            Log("Finished drawing a gesture");

            SaveQueryRecord();
        };
        // If the drawn gesture matches, then proceed to the practice stage
        gesturePassedCallback = () =>
        {
            stopwatchStage.Stop();

            stageStarted = false;

            Log("Create Time: " + stopwatchStage.ElapsedMilliseconds + "ms");

            PracticeStage();
        };
        // If the drawn gesture doesn't match, then prompt the user to restart 
        gestureFailedCallback = () =>
        {
            gestureHandler.Clear();

            InformationDisableAll();
            interactionCubeLeft.GetComponent<MeshRenderer>().enabled = true;
            interactionCubeRight.GetComponent<MeshRenderer>().enabled = true;
            informationTextCenter.enabled = informationTextRight.enabled = informationTextLeft.enabled = informationPicture.enabled = true;
            informationTextCenter.text = "<color=red>The gestures don't match</color>";
            informationTextLeft.text = "Put your <b>right</b> hand into the <b>LEFT</b> cube\nand wait to create a new gesture";
            informationTextRight.text = "Put your <b>right</b> hand into the <b>RIGHT</b> cube\nand wait to try mathing again";
            informationPicture.sprite = rightHandOpenSprite;

            // Move left interaction cube to the original main camera viewpoint
            PositionObject(interactionCubeLeft, localCoordinateFrame.transform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_LEFT_ROTATION, INTERACTION_CUBE_DISTANCE);

            // Move right interaction cube to the original main camera viewpoint
            PositionObject(interactionCubeRight, localCoordinateFrame.transform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_RIGHT_ROTATION, INTERACTION_CUBE_DISTANCE);

            interactionHandler.UserPromptCallback = null;
            interactionHandler.UserActionCallback1 = CreateStage;
            interactionHandler.UserActionCallback2 = MatchStage;

            InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);
        };

        InitializeHandSubsystem(ref m_HandSubsystem, gestureHandler.OnUpdatedHandsRecord);
    }

    /**
     *  Practice stage of the experiment.
     */
    private void PracticeStage()
    {
        currentExperimentStage = ExperimentStageEnum.PracticeStage;

        gestureHandler.Clear();

        InformationDisableAll();

        // Finish the practice stage
        if (currentPracticeAttempt == practiceRounds)
        {
            stopwatchStage.Stop();

            stageStarted = false;

            Log("Practice Time: " + stopwatchStage.ElapsedMilliseconds + "ms");

            DistractStage();
        }
        // Continue the practice stage
        else
        {
            Log("Practice attempt " + currentPracticeAttempt + "/" + practiceRounds);

            interactionRegion.GetComponent<LineRenderer>().enabled = true;
            informationTextCenterTop.enabled = informationTextCenterBottom.enabled = informationPicture.enabled = true;
            informationTextCenterTop.text = "Practice " + currentPracticeAttempt + "/" + practiceRounds;
            informationTextCenterBottom.text = "Draw your gesture inside the <color=#00FFFFFF>highlighted</color> area";
            informationPicture.sprite = rightHandPinchSprite;

            queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_practice_" + currentPracticeAttempt;
            Directory.CreateDirectory(experimentPath + "\\" + queryDir);

            currentPracticeAttempt++;

            // Move interaction region to the original main camera viewpoint
            PositionObject(interactionRegion, localCoordinateFrame.transform, INTERACTION_REGION_POSITION_OFFSET, INTERACTION_REGION_POSITION_OFFSET, Quaternion.identity, INTERACTION_REGION_DISTANCE);

            gestureHandler.RecordStartedCallback = () =>
            {
                if (stageStarted == false)
                {
                    stopwatchStage.Restart();

                    stageStarted = true;
                }

                Log("Started drawing a gesture");
            };
            gestureHandler.RecordFinishedCallback = () =>
            {
                Log("Finished drawing a gesture");

                SaveQueryRecord();
            };
            // If the drawn gesture matches, then display the feedback and prompt to continue
            gesturePassedCallback = () =>
            {
                PromptToContinue(PracticeStage);

                informationTextCenter.text = "<color=green>The gestures match!</color>\n\n" + informationTextCenter.text;
            };
            // If the drawn gesture doesn't match, then display the feedback and prompt to continue
            gestureFailedCallback = () =>
            {
                PromptToContinue(PracticeStage);

                informationTextCenter.text = "<color=red>The gestures don't match!</color>\n\n" + informationTextCenter.text;
            };

            InitializeHandSubsystem(ref m_HandSubsystem, gestureHandler.OnUpdatedHandsRecord);
        }
    }

    /**
     *  Distract stage of the experiment.
     */
    private void DistractStage()
    {
        // Distract stage is finished
        if (distractFinished)
        {
            currentExperimentStage = ExperimentStageEnum.UninitializedStage;

            InformationDisableAll();
            interactionCubeLeft.GetComponent<MeshRenderer>().enabled = true;
            informationTextCenter.enabled = informationPicture.enabled = true;
            informationTextCenter.text = "Put your <b>right</b> hand into the cube and wait to continue";
            informationPicture.sprite = rightHandOpenSprite;

            // Update the location of the information board and interaction cube at each frame
            interactionHandler.UserPromptCallback = () =>
            {
                // Move information board to the current main camera viewpoint
                PositionObject(informationBoard, mainCameraTransform, BOARD_POSITION_OFFSET, Vector3.zero, Quaternion.identity, BOARD_DISTANCE);

                // Move left interaction cube to the current main camera viewpoint
                PositionObject(interactionCubeLeft, mainCameraTransform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, Quaternion.identity, INTERACTION_CUBE_DISTANCE);
            };
            interactionHandler.UserActionCallback1 = () =>
            {
                // Record current transform of the main camera
                RecordCurrentTransform(localCoordinateFrame);

                RecallStage();
            };
            interactionHandler.UserActionCallback2 = null;

            InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);

            return;
        }

        // Distract stage is initialized for the first time
        if (currentExperimentStage != ExperimentStageEnum.DistractStage)
        {
            currentExperimentStage = ExperimentStageEnum.DistractStage;

            stopwatchDistract.Start();

            InformationDisableAll();
            informationTextCenterBottom.enabled = true;
        }

        // The distract time is not up yet
        if (stopwatchDistract.ElapsedMilliseconds / 1000 < distractTimeSeconds)
        {
            long minutesLeft = (distractTimeSeconds - stopwatchDistract.ElapsedMilliseconds / 1000) / 60;
            long secondsLeft = distractTimeSeconds - stopwatchDistract.ElapsedMilliseconds / 1000 - minutesLeft * 60;

            informationTextCenterBottom.text = "Put your headset away and wait\n" + minutesLeft.ToString("00") + ":" + secondsLeft.ToString("00");
        }
        // The distract time is up
        else
        {
            stopwatchDistract.Stop();

            Log("Distract time is up");

            distractFinished = true;
        }
    }

    /**
     *  Recall stage of the experiment.
     */
    private void RecallStage()
    {
        currentExperimentStage = ExperimentStageEnum.RecallStage;

        gestureHandler.Clear();

        InformationDisableAll();

        // Finish the recall stage
        if (currentRecallAttempt == recallAttempts || recallFinished)
        {
            stopwatchStage.Stop();

            stageStarted = false;

            Log("Recall Time: " + stopwatchStage.ElapsedMilliseconds + "ms");

            uint recallFails = recallFinished ? currentRecallAttempt - 1 : recallAttempts;

            Log("Recall Fails: " + recallFails);

            FinishStage();
        }
        // Continue the recall stage
        else
        {
            Log("Recall attempt " + currentRecallAttempt + "/" + recallAttempts);

            interactionRegion.GetComponent<LineRenderer>().enabled = true;
            informationTextCenterTop.enabled = informationTextCenterBottom.enabled = informationPicture.enabled = true;
            informationTextCenterTop.text = "Recall Attempt " + currentRecallAttempt + "/" + recallAttempts;
            informationTextCenterBottom.text = "Draw your gesture inside the <color=#00FFFFFF>highlighted</color> area";
            informationPicture.sprite = rightHandPinchSprite;

            queryDir = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeSeconds() + "_recall_" + currentRecallAttempt;
            Directory.CreateDirectory(experimentPath + "\\" + queryDir);

            currentRecallAttempt++;

            // Move interaction region to the original main camera viewpoint
            PositionObject(interactionRegion, localCoordinateFrame.transform, INTERACTION_REGION_POSITION_OFFSET, INTERACTION_REGION_POSITION_OFFSET, Quaternion.identity, INTERACTION_REGION_DISTANCE);

            gestureHandler.RecordStartedCallback = () =>
            {
                if (stageStarted == false)
                {
                    stopwatchStage.Restart();

                    stageStarted = true;
                }

                Log("Started drawing a gesture");
            };
            gestureHandler.RecordFinishedCallback = () =>
            {
                Log("Finished drawing a gesture");

                SaveQueryRecord();
            };
            gesturePassedCallback = () =>
            {
                recallFinished = true;

                PromptToContinue(RecallStage);

                informationTextCenter.text = "<color=green>The gestures match!</color>\n\n" + informationTextCenter.text;
            };
            gestureFailedCallback = () =>
            {
                PromptToContinue(RecallStage);

                informationTextCenter.text = "<color=red>The gestures don't match!</color>\n\n" + informationTextCenter.text;
            };

            InitializeHandSubsystem(ref m_HandSubsystem, gestureHandler.OnUpdatedHandsRecord);
        }
    }

    /**
     *  Finish stage of the experiment.
     */
    private void FinishStage()
    {
        currentExperimentStage = ExperimentStageEnum.FinishStage;

        gestureHandler.Clear();

        InformationDisableAll();
        informationTextCenterBottom.enabled = true;
        informationTextCenterBottom.text = "The experiment is over. Thank you for participation!";

        stopwatchTotal.Stop();

        Log("Total Time: " + (stopwatchTotal.ElapsedMilliseconds / 1000) + "s");
    }

    /**
     *  Recall setup stage of the experiment.
     */
    private void RecallSetupStage()
    {
        currentExperimentStage = ExperimentStageEnum.RecallSetupStage;

        gestureHandler.Clear();

        InformationDisableAll();
        interactionCubeLeft.GetComponent<MeshRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Welcome back\nPut your <b>right</b> hand into the cube and wait to continue";
        informationPicture.sprite = rightHandOpenSprite;

        // Update the location of the information board and interaction cube at each frame
        interactionHandler.UserPromptCallback = () =>
        {
            // Move information board to the current main camera viewpoint
            PositionObject(informationBoard, mainCameraTransform, BOARD_POSITION_OFFSET, Vector3.zero, Quaternion.identity, BOARD_DISTANCE);

            // Move left interaction cube to the current main camera viewpoint
            PositionObject(interactionCubeLeft, mainCameraTransform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, Quaternion.identity, INTERACTION_CUBE_DISTANCE);
        };
        interactionHandler.UserActionCallback1 = () =>
        {
            // Record current transform of the main camera
            RecordCurrentTransform(localCoordinateFrame);

            RecallStage();
        };
        interactionHandler.UserActionCallback2 = null;

        InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);
    }

    /**
     *  Prompt user to continue
     */
    private void PromptToContinue(InteractionHandler.ProcedureCallback callback)
    {
        currentExperimentStage = ExperimentStageEnum.UninitializedStage;

        gestureHandler.Clear();

        InformationDisableAll();
        interactionCubeRight.GetComponent<MeshRenderer>().enabled = true;
        informationTextCenter.enabled = informationPicture.enabled = true;
        informationTextCenter.text = "Put your <b>right</b> hand into the cube and wait";
        informationPicture.sprite = rightHandOpenSprite;

        // Move right interaction cube to the original main camera viewpoint
        PositionObject(interactionCubeRight, localCoordinateFrame.transform, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_POSITION_OFFSET, INTERACTION_CUBE_RIGHT_ROTATION, INTERACTION_CUBE_DISTANCE);

        interactionHandler.UserPromptCallback = null;
        interactionHandler.UserActionCallback1 = null;
        interactionHandler.UserActionCallback2 = callback;

        InitializeHandSubsystem(ref m_HandSubsystem, interactionHandler.OnUpdatedHandsPromptUser);
    }

    /**
     *  Position an object from the main camera viewpoint
     */
    private void PositionObject(GameObject gameObject, Transform coordinateFrame, Vector3 positionOffset, Vector3 lookOffeset, Quaternion rotation, float distance)
    {
        gameObject.transform.position =
            coordinateFrame.position + positionOffset + rotation * new Vector3(coordinateFrame.forward.x, 0, coordinateFrame.forward.z).normalized * (distance + gameObject.transform.localScale.z / 2);
        gameObject.transform.LookAt(new Vector3(coordinateFrame.position.x + lookOffeset.x, coordinateFrame.position.y + lookOffeset.y, coordinateFrame.position.z + lookOffeset.z));
        gameObject.transform.forward *= -1;
    }

    /**
     *  Position tutorial line
     */
    private void PositionTutorialLine(Vector3 start, Vector3 end)
    {
        startPoint.transform.position = interactionRegion.transform.TransformPoint(start);
        endPoint.transform.position = interactionRegion.transform.TransformPoint(end);
        tutorialLine.SetPosition(0, start);
        tutorialLine.SetPosition(1, end);
    }

    /**
     *  Record the current transform (position, rotation, scale) of the camera.
     */
    private void RecordCurrentTransform(GameObject coordinateFrame)
    {
        Vector3 cameraPosition = mainCameraTransform.position;
        coordinateFrame.transform.position = new Vector3(cameraPosition.x, cameraPosition.y, cameraPosition.z);

        Quaternion cameraRotation = mainCameraTransform.rotation;
        coordinateFrame.transform.rotation = new Quaternion(cameraRotation.x, cameraRotation.y, cameraRotation.z, cameraRotation.w);
    }

    /**
     *  Get hand subsystem from SubsystemManager and register a callback for updated hands event.
     */
    private void InitializeHandSubsystem(ref XRHandSubsystem subsystem, Action<XRHandSubsystem, XRHandSubsystem.UpdateSuccessFlags, XRHandSubsystem.UpdateType> OnUpdatedHands)
    {
        List<XRHandSubsystem> handSubsystems = new List<XRHandSubsystem>();
        SubsystemManager.GetSubsystems(handSubsystems);

        foreach (XRHandSubsystem handSubsystem in handSubsystems)
        {
            if (handSubsystem.running)
            {
                subsystem = handSubsystem;
                subsystem.updatedHands += OnUpdatedHands;
                return;
            }
        }
    }

    void SaveSampleRecord()
    {
        // Save the transformed gesture for Jackknife
        gestureHandler.Save(sampleDir);

        Log("Gesture saved to " + Path.Combine(experimentPath, sampleDir, "ex.txt"));
        Log("Timestamps saved to " + Path.Combine(experimentPath, sampleDir, "timestamps.txt"));

        int currentGestureSimplificationScore = gestureHandler.SimplificationScore();
        float currentGestureLength = gestureHandler.Length();

        Log("Gesture simplification score: " + currentGestureSimplificationScore);
        Log("Gesture length: " + currentGestureLength);

        if (currentGestureSimplificationScore >= GESTURE_SIMPLIFICATION_SCORE_THRESHOLD && currentGestureLength >= GESTURE_LENGTH_THRESHOLD)
        {
            Log("Draw Time (Valid): " + gestureHandler.StopwatchDraw.ElapsedMilliseconds + "ms");

            gesturePassedCallback?.Invoke();
        }
        else
        {
            Log("Draw Time (Invalid): " + gestureHandler.StopwatchDraw.ElapsedMilliseconds + "ms");

            gestureFailedCallback?.Invoke();
        }
    }

    void SaveQueryRecord()
    {
        // Save the transformed gesture for Jackknife
        gestureHandler.Save(queryDir);

        Log("Gesture saved to " + Path.Combine(experimentPath, queryDir, "ex.txt"));
        Log("Timestamps saved to " + Path.Combine(experimentPath, queryDir, "timestamps.txt"));

        double gestureJackknifeScore = gestureHandler.JackknifeScore(sampleDir, queryDir);

        Log("Gesture match score: " + gestureJackknifeScore.ToString("0.#######"));

        if (gestureJackknifeScore >= GESTURE_SCORE_THRESHOLD)
        {
            Log("Draw Time (Passed): " + gestureHandler.StopwatchDraw.ElapsedMilliseconds + "ms");

            gesturePassedCallback?.Invoke();
        }
        else
        {
            Log("Draw Time (Failed): " + gestureHandler.StopwatchDraw.ElapsedMilliseconds + "ms");

            gestureFailedCallback?.Invoke();
        }
    }

    /**
     *  Disable all information objects.
     */
    private void InformationDisableAll()
    {
        interactionCubeLeft.GetComponent<MeshRenderer>().enabled = false;
        interactionCubeRight.GetComponent<MeshRenderer>().enabled = false;
        interactionRegion.GetComponent<LineRenderer>().enabled = false;

        tutorialLine.enabled = false;
        startPoint.GetComponent<MeshRenderer>().enabled = false;
        endPoint.GetComponent<MeshRenderer>().enabled = false;

        informationTextCenterTop.enabled = false;
        informationTextCenterBottom.enabled = false;
        informationTextCenter.enabled = false;
        informationTextLeft.enabled = false;
        informationTextRight.enabled = false;
        informationPicture.enabled = false;
    }

    /**
     *  Log function.
     */
    private void Log(string logData)
    {
        StreamWriter sw = new StreamWriter(logPath, true);
        string output = "[" + new DateTimeOffset(DateTime.UtcNow).ToUnixTimeMilliseconds() + "] [" + DateTime.Now + "] {" + currentExperimentStage + "} ";
        if (currentExperimentStage == ExperimentStageEnum.TutorialStage)
        {
            output += "[" + currentTutorialStage + "] ";
        }
        sw.WriteLine(output + logData);
        sw.Close();
    }
}

internal class InteractionHandler
{
    // How long it takes to confirm interaction with a cube
    private const long INTERACTION_CUBE_TIME_THRESHOLD = 500;

    // How fast cube becomes opaque when interacted with
    private const float INTERACTION_CUBE_ALPHA_SPEED = 0.25f;

    // How fast cube expands when interacted with
    private const float INTERACTION_CUBE_EXPANSION_SPEED = 0.02f;

    public delegate void ProcedureCallback();                           // Callback for the experiment's procedures

    private GameObject interactionCube1;                                // First interaction cube object
    private GameObject interactionCube2;                                // Second interaction cube object

    private readonly Stopwatch stopwatchCollision1 = new Stopwatch();   // Timer for first cube collision register
    private readonly Stopwatch stopwatchCollision2 = new Stopwatch();   // Timer for second cube collision register

    private bool collisionStarted1;                                     // First interaction cube collision started
    private bool collisionStarted2;                                     // Second interaction cube collision started

    private Vector3 interactionCubeScale;                               // Original scale of an interaction cube
    private Color interactionCubeColor;                                 // Original color of an interaction cube

    public ProcedureCallback UserPromptCallback { get; set; }           // Each frame during the user prompting
    public ProcedureCallback UserActionCallback1 { get; set; }          // First cube is selected
    public ProcedureCallback UserActionCallback2 { get; set; }          // Second cube is selected

    internal InteractionHandler(GameObject interactionCube1, GameObject interactionCube2)
    {
        this.interactionCube1 = interactionCube1;
        this.interactionCube2 = interactionCube2;
        interactionCubeColor = interactionCube1.GetComponent<Renderer>().material.color;
        interactionCubeScale = interactionCube1.transform.localScale;
    }

    /**
     *  Callback function for updated hands to prompt user
     */
    public void OnUpdatedHandsPromptUser(XRHandSubsystem subsystem, XRHandSubsystem.UpdateSuccessFlags updateSuccessFlags, XRHandSubsystem.UpdateType updateType)
    {
        UserPromptCallback?.Invoke();

        // If there is a callback for interaction cube 1
        if (UserActionCallback1 != null)
        {
            if (TryRecordInteraction(interactionCube1, stopwatchCollision1, ref collisionStarted1))
            {
                subsystem.updatedHands -= OnUpdatedHandsPromptUser;

                UserActionCallback1();
            }
        }

        // If there is a callback for interaction cube 2
        if (UserActionCallback2 != null)
        {
            if (TryRecordInteraction(interactionCube2, stopwatchCollision2, ref collisionStarted2))
            {
                subsystem.updatedHands -= OnUpdatedHandsPromptUser;

                UserActionCallback2();
            }
        }
    }

    /**
     *  Record user interaction
     */
    private bool TryRecordInteraction(GameObject interactionCube, Stopwatch stopwatchCollision, ref bool collisionStarted)
    {
        // If there is a collision between a hand and an interaction cube
        if (interactionCube.GetComponent<CollisionDetection>().CollidingObjects > 0)
        {
            if (!collisionStarted)
            {
                collisionStarted = true;

                // Reset interaction cube
                interactionCube.GetComponent<Renderer>().material.color = interactionCubeColor;
                interactionCube.transform.localScale = interactionCubeScale;

                stopwatchCollision.Restart();
            }

            Color newColor = new Color(interactionCubeColor.r, interactionCubeColor.g, interactionCubeColor.b, interactionCube.GetComponent<Renderer>().material.color.a + Time.deltaTime * INTERACTION_CUBE_ALPHA_SPEED);

            interactionCube.GetComponent<Renderer>().material.color = newColor;

            interactionCube.transform.localScale += Vector3.one * Time.deltaTime * INTERACTION_CUBE_EXPANSION_SPEED;

            if (stopwatchCollision.ElapsedMilliseconds >= INTERACTION_CUBE_TIME_THRESHOLD)
            {
                collisionStarted = false;

                // Interaction has been recorded
                return true;
            }
        }
        else
        {
            collisionStarted = false;

            // Reset interaction cube
            interactionCube.GetComponent<Renderer>().material.color = interactionCubeColor;
            interactionCube.transform.localScale = interactionCubeScale;
        }

        // Interaction has not been recorded
        return false;
    }
}

public class GestureHandler
{
    // Strength threshold to start registering a pinch
    private const float PINCH_SRENGTH_ENTRY_THRESHOLD = 0.9f;

    // Strength threshold to continue registering a pinch
    private const float PINCH_SRENGTH_MAINTAIN_THRESHOLD = 0.5f;

    private const float PINCH_TIMER_DISTANCE_THRESHOLD = 0.03f;

    private const float PINCH_DISABLE_DISTANCE_THRESHOLD = 0.06f;

    // Time threshold to ignore an accidental pinch
    private const long PINCH_IGNORE_TIME_THRESHOLD = 500;

    // Length threshold to ignore an accidental gesture
    private const float GESTURE_IGNORE_LENGTH_THRESHOLD = 0.1f;

    // Smoothing factor to reduce gesture noise
    private const float GESTURE_SMOOTHING_FACTOR = 16f;

    // Epsilon value for DP line simplification to pass create stage
    private const float GESTURE_SIMPLIFICATION_TOLERANCE = 0.13f;

    private const long DISTANCE_TOLERANCE_MILLISECONDS = 1500;

    private const long REGION_TOLERANCE_MILLISECONDS = 1500;

    public delegate void ProcedureCallback();                       // Callback for the experiment's procedures

    private string experimentPath;                                  // Path to the experiment's working directory

    private List<Vector3> gesture = new List<Vector3>();            // Gesture in the local coordinate frame
    private List<long> gestureTimestamps = new List<long>();        // Gesture's timestmaps
    Vector3 lastGesturePointWorldCoordinate;                        // Last gesture point in the world coordinate frame
    private bool pinchStarted;                                      // Started a pinch
    private bool gestureStarted;                                    // Started drawing a gesture

    HashSet<XRHandJointID> validJoints = new HashSet<XRHandJointID>();

    private List<List<Vector3>> joints_position;
    private List<List<Quaternion>> joints_rotation;
    private List<float> joints_radius;
    private List<List<Vector3>> joints_linear_velocity;
    //private List<List<Vector3>> joints_angular_velocity;

    private GameObject feedbackSphere;

    private Transform interactionRegionTransform;                   // Transform of the interaction region
    private Bounds interactionRegionBounds;                         // Bounds of the interaction region
    private TrailHandler trailHandler;                              // Trail handler to draw gesture trail

    private readonly Stopwatch stopwatchDraw = new Stopwatch();     // Timer for the gesture drawing time

    private readonly Stopwatch stopwatchDistance = new Stopwatch();  // Time for disabling gesture recognition
    private readonly Stopwatch stopwatchRegion = new Stopwatch();  // Time for disabling gesture recognition
    private bool outOfDistance;
    private bool outOfRegion;

    public ProcedureCallback RecordStartedCallback { get; set; }    // Gesture recording started callback
    public ProcedureCallback RecordFinishedCallback { get; set; }   // Gesture recording finished callback
    public Stopwatch StopwatchDraw                                  // StopwatchDraw property
    {
        get
        {
            return stopwatchDraw;
        }
    }

    public GestureHandler(string experimentPath, Transform interactionRegionTransform, TrailHandler trailHandler, GameObject feedbackSphere)
    {
        this.feedbackSphere = feedbackSphere;

        this.experimentPath = experimentPath;
        this.interactionRegionTransform = interactionRegionTransform;
        this.trailHandler = trailHandler;

        interactionRegionBounds = new Bounds(Vector3.zero, Vector3.one);

        int jointCount = Enum.GetNames(typeof(XRHandJointID)).Length;

        foreach (XRHandJointID jointID in Enum.GetValues(typeof(XRHandJointID)).Cast<XRHandJointID>())
        {
            if (jointID == XRHandJointID.EndMarker || jointID == XRHandJointID.Invalid)
                continue;

            validJoints.Add(jointID);
        }

        joints_position = Enumerable.Repeat(0, jointCount).Select(_ => new List<Vector3>()).ToList();
        joints_rotation = Enumerable.Repeat(0, jointCount).Select(_ => new List<Quaternion>()).ToList();
        joints_radius = Enumerable.Repeat(0, jointCount).Select(_ => new float()).ToList();
        joints_linear_velocity = Enumerable.Repeat(0, jointCount).Select(_ => new List<Vector3>()).ToList();
        //joints_angular_velocity = Enumerable.Repeat(0, jointCount).Select(_ => new List<Vector3>()).ToList();
    }

    /**
     *  Callback function for updated hands to record a gesture
     */
    public void OnUpdatedHandsRecord(XRHandSubsystem subsystem, XRHandSubsystem.UpdateSuccessFlags updateSuccessFlags, XRHandSubsystem.UpdateType updateType)
    {     
        float pinchStrength = MetaAimHand.right.pinchStrengthIndex.magnitude;

        // If a pinch is being registered for the first time
        bool pinchEntered = !pinchStarted && pinchStrength >= PINCH_SRENGTH_ENTRY_THRESHOLD;

        if (pinchEntered)
        {
            pinchStarted = true;
        }

        // If a pinch has already been registered
        //bool pinchMaintained = pinchStarted && pinchStrength >= PINCH_SRENGTH_MAINTAIN_THRESHOLD;

        //if (!pinchMaintained)
        //{
        //    pinchStarted = false;
        //}

        // Start gesture if the pinch has been recorded inside the interaction region
        bool positionRecorded = false;
        
        if (pinchEntered)
        {
            feedbackSphere.GetComponent<MeshRenderer>().enabled = true;

            positionRecorded = TryRecordPosition(subsystem);

            if (positionRecorded)
            {
                RecordStartedCallback?.Invoke();

                stopwatchDraw.Restart();

                gestureStarted = true;
            }
        }

        // If the gesture has just finished
        //if (!(pinchMaintained && (positionRecorded || (gestureStarted && TryRecordPosition(subsystem)))) && gestureStarted)
        if (gestureStarted && !(positionRecorded || TryRecordPosition(subsystem)))
        {
            stopwatchDraw.Stop();

            feedbackSphere.GetComponent<MeshRenderer>().enabled = false;

            // Ignore accidental pinches
            if (stopwatchDraw.ElapsedMilliseconds < PINCH_IGNORE_TIME_THRESHOLD || Length() < GESTURE_IGNORE_LENGTH_THRESHOLD)
            {
                Clear();

                return;
            }

            subsystem.updatedHands -= OnUpdatedHandsRecord;

            RecordFinishedCallback?.Invoke();
        }
    }

    /**
     *  Return match score between sample gesture and query gesture using Jackknife's recognizer
     */
    public double JackknifeScore(string sampleGesture, string queryGesture)
    {
        // Initialize dataset and blades
        Jackknife.Evaluate.Dataset ds = new Jackknife.Evaluate.Dataset();
        Jackknife.JackknifeBlades blades = new Jackknife.JackknifeBlades();

        // Load all gesures
        Jackknife.Evaluate.Dataset.LoadSubjectDataset(ds, experimentPath);

        // Use experiment's custom Jackknife settings
        blades.SetIPDefaults();

        // Initialize Jackknife
        Jackknife.Jackknife jk = new Jackknife.Jackknife(blades);

        // Add sample gesture as a Jackknife template
        foreach (Jackknife.Sample sample in ds.SamplesByGesture[ds.Gestures.IndexOf(sampleGesture)])
        {
            jk.AddTemplate(sample);
        }

        // Get Jackknife match score of the query gesture
        double jackknifeScore = 1 / jk.MatchScore(ds.SamplesByGesture[ds.Gestures.IndexOf(queryGesture)][0]);

        return jackknifeScore;
    }

    /**
     *  Return number of points after applying DP simplification algorithm
     */
    public int SimplificationScore()
    {
        // Normalize gesture by scaling and moving each point to the center
        List<Vector3> normalizedGesture = new List<Vector3>();

        float xMin = gesture.Min(p => p.x);
        float yMin = gesture.Min(p => p.y);
        float zMin = gesture.Min(p => p.z);

        float xMax = gesture.Max(p => p.x - xMin);
        float yMax = gesture.Max(p => p.y - yMin);
        float zMax = gesture.Max(p => p.z - zMin);

        // The maximum among all three coordinate axis
        float max = Math.Max(xMax, Math.Max(yMax, zMax));

        foreach (Vector3 point in gesture)
        {
            normalizedGesture.Add(new Vector3((point.x - xMin) / max, (point.y - yMin) / max, (point.z - zMin) / max));
        }
        
        List<Vector3> simplifiedGesture = new List<Vector3>();

        // Simplify gesture by applying DP simplification algorithm
        LineUtility.Simplify(normalizedGesture, GESTURE_SIMPLIFICATION_TOLERANCE, simplifiedGesture);

        return simplifiedGesture.Count;
    }

    /**
     *  Return length of the gesture
     */
    public float Length()
    {
        float length = 0;

        for (int i = 1; i < gesture.Count; i++)
        {
            length += (gesture[i] - gesture[i - 1]).magnitude;
        }

        return length;
    }

    /**
     *  Clear gesture
     */
    public void Clear()
    {
        gesture.Clear();
        gestureTimestamps.Clear();

        foreach (XRHandJointID jointID in validJoints)
        {
            joints_position[jointID.ToIndex()].Clear();
            joints_rotation[jointID.ToIndex()].Clear();
            joints_linear_velocity[jointID.ToIndex()].Clear();
            //joints_angular_velocity[jointID.ToIndex()].Clear();
        }

        lastGesturePointWorldCoordinate = Vector3.zero;
        pinchStarted = false;
        gestureStarted = false;

        outOfDistance = false;
        outOfRegion = false;

        trailHandler.Clear();
    }

    /**
     *  Save gesture according to Jackknife format
     */
    public void Save(string recordName)
    {
        // Save gesture's coordinates
        StreamWriter sw = new StreamWriter(Path.Combine(experimentPath, recordName, "ex.txt"));

        // Record's name
        sw.WriteLine(recordName);

        // Number of points
        sw.WriteLine(gesture.Count);

        foreach (Vector3 point in gesture)
        {
            // Separator
            sw.WriteLine("####");

            // Three floats in x, y, z format with 7 digits after comma
            sw.WriteLine(point.x.ToString("0.#######") + "," + point.y.ToString("0.#######") + "," + point.z.ToString("0.#######"));
        }

        sw.Close();

        // Save gesture's timestamps
        sw = new StreamWriter(Path.Combine(experimentPath, recordName, "timestamps.csv"));
        sw.WriteLine(recordName);
        sw.WriteLine(gestureTimestamps.Count);
        foreach (long timestamp in gestureTimestamps)
        {
            sw.WriteLine(timestamp);
        }
        sw.Close();

        // Save joints' radius
        sw = new StreamWriter(Path.Combine(experimentPath, recordName, "radius.csv"));
        sw.WriteLine(recordName);
        foreach (XRHandJointID jointID in validJoints)
        {
            sw.WriteLine(jointID.ToString() + ";" + joints_radius[jointID.ToIndex()].ToString("0.#######"));
        }
        sw.Close();

        foreach (XRHandJointID jointID in validJoints)
        {
            // Save joints' position
            Directory.CreateDirectory(Path.Combine(experimentPath, recordName, "position"));
            sw = new StreamWriter(Path.Combine(experimentPath, recordName, "position", jointID.ToString() + ".csv"));
            sw.WriteLine(recordName);
            sw.WriteLine(joints_position[jointID.ToIndex()].Count);
            foreach (Vector3 p in joints_position[jointID.ToIndex()])
            {
                sw.WriteLine(p.x.ToString("0.#######") + ";" + p.y.ToString("0.#######") + ";" + p.z.ToString("0.#######"));
            }
            sw.Close();

            // Save joints' rotation
            Directory.CreateDirectory(Path.Combine(experimentPath, recordName, "rotation"));
            sw = new StreamWriter(Path.Combine(experimentPath, recordName, "rotation", jointID.ToString() + ".csv"));
            sw.WriteLine(recordName);
            sw.WriteLine(joints_rotation[jointID.ToIndex()].Count);
            foreach (Quaternion q in joints_rotation[jointID.ToIndex()])
            {
                sw.WriteLine(q.x.ToString("0.#######") + ";" + q.y.ToString("0.#######") + ";" + q.z.ToString("0.#######") + ";" + q.w.ToString("0.#######"));
            }
            sw.Close();

            Directory.CreateDirectory(Path.Combine(experimentPath, recordName, "joints_linear_velocity"));
            sw = new StreamWriter(Path.Combine(experimentPath, recordName, "joints_linear_velocity", jointID.ToString() + ".csv"));
            sw.WriteLine("joints_linear_velocity_" + jointID.ToString());
            sw.WriteLine(joints_linear_velocity[jointID.ToIndex()].Count);
            foreach (Vector3 lv in joints_linear_velocity[jointID.ToIndex()])
            {
                sw.WriteLine(lv.x.ToString("0.#######") + ";" + lv.y.ToString("0.#######") + ";" + lv.z.ToString("0.#######"));
            }
            sw.Close();

            /*
            Directory.CreateDirectory(Path.Combine(experimentPath, recordName, "joints_angular_velocity"));
            sw = new StreamWriter(Path.Combine(experimentPath, recordName, "joints_angular_velocity", jointID.ToString() + ".csv"));
            sw.WriteLine("joints_angular_velocity_" + jointID.ToString());
            sw.WriteLine(joints_angular_velocity[jointID.ToIndex()].Count);
            foreach (Vector3 av in joints_angular_velocity[jointID.ToIndex()])
            {
                sw.WriteLine(av.x.ToString("0.#######") + ";" + av.y.ToString("0.#######") + ";" + av.z.ToString("0.#######"));
            }
            sw.Close();
            */
        }
    }

    /**
     *  Try to record a position between an index finger and a thumb and add it to the gesture
     */
    private bool TryRecordPosition(XRHandSubsystem subsystem)
    {
        // Record current timestamp
        long timestamp = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeMilliseconds();

        // Get both index's and thumb's tips
        XRHandJoint handJointIndexTip = subsystem.rightHand.GetJoint(XRHandJointID.IndexTip);
        XRHandJoint handJointThumbTip = subsystem.rightHand.GetJoint(XRHandJointID.ThumbTip);

        if (handJointIndexTip.TryGetPose(out Pose indexPose) && handJointThumbTip.TryGetPose(out Pose thumbPose))
        {
            float distance = (indexPose.position - thumbPose.position).magnitude;

            if (distance > PINCH_DISABLE_DISTANCE_THRESHOLD || (outOfDistance && stopwatchDistance.ElapsedMilliseconds > DISTANCE_TOLERANCE_MILLISECONDS) 
                || (outOfRegion && stopwatchRegion.ElapsedMilliseconds > REGION_TOLERANCE_MILLISECONDS))
            {
                return false;
            }
            else if (distance > PINCH_TIMER_DISTANCE_THRESHOLD)
            {
                if (!outOfDistance)
                {
                    feedbackSphere.GetComponent<Renderer>().material.color = new Color(1, 0, 0, 1);
                    outOfDistance = true;
                    stopwatchDistance.Restart();
                }
            }
            else
            {
                if (!outOfRegion)
                {
                    feedbackSphere.GetComponent<Renderer>().material.color = new Color(0, 1, 0, 1);
                }
                outOfDistance = false;
            }

            // Calculate position as an average between an index's and a thumb's tips
            Vector3 positionWorld = (indexPose.position + thumbPose.position) / 2f;

            // Smooth to reduce noise
            positionWorld = Vector3.Lerp(lastGesturePointWorldCoordinate != Vector3.zero ? lastGesturePointWorldCoordinate : positionWorld, positionWorld, Time.deltaTime * GESTURE_SMOOTHING_FACTOR);

            // Update position of the feedback sphere
            feedbackSphere.transform.position = positionWorld;

            // Transform position to the local coordinate frame of the interaction region
            Vector3 position = interactionRegionTransform.InverseTransformPoint(positionWorld);

            // Smooth to reduce noise
            position = Vector3.Lerp(gesture.DefaultIfEmpty(position).Last(), position, Time.deltaTime * GESTURE_SMOOTHING_FACTOR);

            // If a point is inside the interaction region
            if (interactionRegionBounds.Contains(position))
            {
                outOfRegion = false;
            }
            else
            {
                if (!outOfRegion)
                {
                    feedbackSphere.GetComponent<Renderer>().material.color = new Color(1, 0, 0, 1);
                    outOfRegion = true;
                    stopwatchRegion.Restart();
                }
            }

            lastGesturePointWorldCoordinate = positionWorld;
            gesture.Add(position);
            gestureTimestamps.Add(timestamp);

            RecordJoints(subsystem);

            // Draw a point
            trailHandler.DrawPoint(position);

            // Position has been recorded
            return true;
        }

        // Position has not been recorded
        return false;
    }

    private void RecordJoints(XRHandSubsystem subsystem)
    {
        // Record current timestamp
        long timestamp = new DateTimeOffset(DateTime.UtcNow).ToUnixTimeMilliseconds();

        foreach (XRHandJointID jointID in validJoints)
        {
            XRHandJoint joint = subsystem.rightHand.GetJoint(jointID);

            int jointIndex = jointID.ToIndex();

            if (joint.TryGetPose(out Pose jointPose))
            {
                Pose worldPose = interactionRegionTransform.InverseTransformPose(jointPose);

                joints_position[jointIndex].Add(worldPose.position);

                joints_rotation[jointIndex].Add(worldPose.rotation);
            }

            if (joint.TryGetRadius(out float radius))
            {
                joints_radius[jointIndex] = radius;
            }

            if (joint.TryGetLinearVelocity(out Vector3 linearVelocity))
            {
                Vector3 worldLinearVelocity = interactionRegionTransform.InverseTransformDirection(linearVelocity);

                joints_linear_velocity[jointIndex].Add(worldLinearVelocity);
            }
        }
    }
}

public class TrailHandler
{
    // Epsilon value for DP line simplification
    private const float TRAIL_SIMPLIFICATION_TOLERANCE = 0.0002f;

    private LineRenderer lineRenderer;  // Line renderer for the gesture trail

    public TrailHandler(LineRenderer lineRenderer)
    {
        this.lineRenderer = lineRenderer;
    }

    /**
     *  Draw a point
     */
    public void DrawPoint(Vector3 point)
    {
        // There is no generic add method, so we have to manually expand the number of positions before setting it
        lineRenderer.positionCount += 1;

        lineRenderer.SetPosition(lineRenderer.positionCount - 1, point);

        // This condition test prevents edge case where 1 point is simplified to nothing
        if (lineRenderer.positionCount > 1)
        {
            // Simplify the trail to smooth rendering
            lineRenderer.Simplify(TRAIL_SIMPLIFICATION_TOLERANCE);
        }
    }

    /**
     *  Clear the trail
     */
    public void Clear()
    {
        lineRenderer.positionCount = 0;
    }
}